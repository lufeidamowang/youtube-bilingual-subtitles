#!name = YouTube 双语字幕
#!desc = 测试版：打开原语言 CC 后添加简体中文。仅处理已有字幕，停用模块恢复原字幕。
#!author = youtube-bilingual-subtitles contributors; DualSubs
#!homepage = https://github.com/lufeidamowang/youtube-bilingual-subtitles
#!version = 0.3.0

[Script]
YTB.Caption.response = type=http-response, pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext(?:\?.*)?$, requires-body=1, max-size=2097152, timeout=20, script-path=https://github.com/lufeidamowang/youtube-bilingual-subtitles/releases/download/v0.3.0/caption-response.js, argument=TargetLanguage=zh-Hans

[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com
tcp-connection = true
